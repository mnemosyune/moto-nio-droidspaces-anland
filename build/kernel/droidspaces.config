# Droidspaces kernel configuration fragment
# Target: Motorola nio (sm8250), Linux 4.19, non-GKI
#
# Adapted from the upstream Droidspaces kernel configuration guide:
#   https://github.com/MGHazz/Droidspaces/blob/main/Documentation/Kernel-Configuration.md
# Droidspaces is GPL-3.0; see CREDITS.md.
#
# Merge it into nio_defconfig at build time:
#   make ... nio_defconfig droidspaces.config
# The kernel build system runs merge_config/olddefconfig automatically.
# Symbols that do not exist on 4.19 are harmlessly dropped by olddefconfig.

# IPC mechanisms
CONFIG_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Core namespaces (required by systemd / container isolation)
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y

# User namespace (optional; Docker/Flatpak/sandboxed browsers)
CONFIG_USER_NS=y

# Runtime kernel config access (/proc/config.gz)
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Seccomp syscall filtering
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Control groups (systemd + resource accounting)
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_NET_PRIO=y

# Device filesystem
CONFIG_DEVTMPFS=y

# OverlayFS (volatile mode)
CONFIG_OVERLAY_FS=y

# Firmware loading (optional, hardware-access mode)
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_FW_LOADER_COMPRESS=y

# Network isolation (NAT / none modes)
CONFIG_NET_NS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y

# Connection tracking
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_IPV4=y

# iptables infrastructure
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y

# NAT
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_NAT_IPV4=y
CONFIG_IP_NF_NAT=y

# MASQUERADE (iptables names on 4.19)
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y

# MSS clamping
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y

# addrtype match (DNAT port forwarding)
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# Conntrack netlink + NAT redirect
CONFIG_NF_CONNTRACK_NETLINK=y
CONFIG_NF_NAT_REDIRECT=y

# Policy routing
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# Required for container internet access on Android kernels
# CONFIG_ANDROID_PARANOID_NETWORK is not set

# cgroup CPU bandwidth control (Droidspaces CPU limits)
CONFIG_CFS_BANDWIDTH=y

# macvlan networking
CONFIG_MACVLAN=y

# IPv6 NAT (ip6tables MASQUERADE)
CONFIG_NF_NAT_IPV6=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# IPv6 nftables NAT (optional)
CONFIG_NFT_MASQ=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CHAIN_NAT_IPV6=y
CONFIG_NFT_MASQ_IPV6=y
